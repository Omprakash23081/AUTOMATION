# Required for Docker Compose. Generate a random value and keep it private.
# PowerShell: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
# Required for Docker Compose. Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep stable and secret; losing it makes encrypted workspace API keys unrecoverable.
CUTROOM_SECRET_ENCRYPTION_KEY=

# YouTube dashboard (Google Cloud OAuth 2.0 Web application credentials).
# Enable YouTube Data API v3 and add this exact authorized redirect URI:
# http://127.0.0.1:5000/api/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Optional: pin the OAuth callback URL. It must exactly match the Google Cloud
# OAuth client's Authorized redirect URI, including hostname, port, and path.
# When blank, Cutroom uses CUTROOM_PUBLIC_URL or the current app origin.
YOUTUBE_REDIRECT_URI=

# Optional account verification and password recovery email.
# Keep disabled for local use; set smtp only after configuring a real mail provider.
CUTROOM_EMAIL_MODE=disabled
# Public origin used in verification/reset links (for example https://studio.example.com).
# Required for correct links behind a reverse proxy; defaults to the request host.
CUTROOM_PUBLIC_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_USE_SSL=false

# Local-only application settings
PORT=5000
CUTROOM_DATA=./data
CUTROOM_MAX_UPLOAD_BYTES=4294967296

# Optional environment variables (this example file is not loaded automatically).
# Set a stable random SESSION_SECRET in the process environment to keep sessions across restarts.
# Generate a fresh secret for each deployment; never commit the real value.
# SESSION_SECRET=
# Optional Groq clip-ranking model override (default: openai/gpt-oss-120b).
# CUTROOM_GROQ_CLIP_MODEL=openai/gpt-oss-120b
# The current local server still uses SQLite and local files; these are future migration settings:
# DATABASE_URL=
# REDIS_URL=
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
